<?xml version="1.0"?>
<!--
  Berry detector node entry point. On-demand: nothing runs until
  /perception/get_berries is called, which returns every detected berry's
  ripeness + 3D position in base_link. remote_camera is an inert deployment
  marker (camera on PC2, time-synced via chrony); it does NOT switch topics,
  mirroring object_detector.launch.
-->
<launch>
  <arg name="params" default="$(find g1_camera)/config/berry_params.yaml"/>
  <arg name="remote_camera" default="false"/>
  <arg name="output" default="screen"/>

  <arg name="rgb_topic"   default="/camera/color/image_raw"/>
  <arg name="depth_topic" default="/camera/aligned_depth_to_color/image_raw"/>
  <arg name="info_topic"  default="/camera/color/camera_info"/>

  <node pkg="g1_camera" type="berry_detector_node.py"
        name="berry_detector_node" output="$(arg output)">
    <rosparam command="load" file="$(arg params)"/>
    <param name="rgb_topic"   value="$(arg rgb_topic)"/>
    <param name="depth_topic" value="$(arg depth_topic)"/>
    <param name="info_topic"  value="$(arg info_topic)"/>
  </node>
</launch>
