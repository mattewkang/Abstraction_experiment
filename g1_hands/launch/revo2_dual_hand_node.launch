<launch>
    <!--
    Bring up both Revo2 hands. Each side is guarded by a bringup_* arg so
    you can start only one (e.g. if a USB port is missing) via:

        roslaunch g1_hands revo2_dual_hand_node.launch bringup_left_hand:=false

    Services exposed (per side):
        /g1_hand_right/pre_grasp      /g1_hand_left/pre_grasp
        /g1_hand_right/grasp_5f       /g1_hand_left/grasp_5f
        /g1_hand_right/release        /g1_hand_left/release
        /g1_hand_right/point_gesture  /g1_hand_left/point_gesture
    -->
    <arg name="bringup_right_hand" default="true"/>
    <arg name="bringup_left_hand"  default="true"/>

    <arg name="right_port"     default="/dev/ttyUSB1"/>
    <arg name="right_slave_id" default="127"/>
    <arg name="left_port"      default="/dev/ttyUSB0"/>
    <arg name="left_slave_id"  default="126"/>

    <group if="$(arg bringup_right_hand)">
        <include file="$(find g1_hands)/launch/revo2_right_hand_node.launch">
            <arg name="port"     value="$(arg right_port)"/>
            <arg name="slave_id" value="$(arg right_slave_id)"/>
        </include>
    </group>

    <group if="$(arg bringup_left_hand)">
        <include file="$(find g1_hands)/launch/revo2_left_hand_node.launch">
            <arg name="port"     value="$(arg left_port)"/>
            <arg name="slave_id" value="$(arg left_slave_id)"/>
        </include>
    </group>
</launch>
